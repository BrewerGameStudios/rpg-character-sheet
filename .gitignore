# admin.html is a deliberately unlinked internal tool (see its own header
# comment) that embeds a live Supabase service_role key — full read/write
# access to every table, bypassing RLS entirely. It must NEVER be committed,
# pushed, or hosted anywhere. Keep it as a local-only file.
admin.html

# One-time password-auth backfill script (2026-09-09) — contains a live
# service_role key once filled in, plus every existing customer's email.
# Local-only, never committed. Safe to delete this whole folder once the
# backfill has been run.
planning/password functions/

